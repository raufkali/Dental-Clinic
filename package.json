{
  "name": "dental-clinic-system",
  "version": "1.0.0",
  "description": "DentSuite — Dental Practice Management & Clinical Accounting System",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT,ELECTRON\" -c \"blue,cyan,green\" \"npm run server\" \"npm run client\" \"wait-on http://127.0.0.1:5001/api/health && electron .\"",
    "dev:web": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"blue,cyan\" \"npm run server\" \"npm run client\"",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "seed": "npm --prefix server run seed",
    "electron": "electron .",
    "build:client": "npm --prefix client run build",
    "pack": "npm run build:client && electron-builder --dir",
    "dist": "npm run build:client && electron-builder",
    "install-all": "npm install && npm --prefix server install && npm --prefix client install"
  },
  "build": {
    "appId": "com.problos.dentsuite",
    "productName": "DentSuite",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "client/dist/**/*",
      "server/**/*",
      "electron/**/*",
      "!electron/bin/mongod.exe",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powertest,example,examples}"
    ],
    "extraResources": [
      {
        "from": "electron/bin/mongod.exe",
        "to": "bin/mongod.exe"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "keywords": [
    "dental",
    "clinic",
    "management",
    "accounting",
    "electron",
    "react"
  ],
  "author": "Antigravity",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "wait-on": "^8.0.1"
  }
}
